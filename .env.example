# === Telegram API（从 my.telegram.org 获取） ===
API_ID=1234567
API_HASH=your_api_hash_here

# Bot Token（从 @BotFather 获取，可选）
BOT_TOKEN=

# 目标群组 ID（负数，需开启 Forum/话题功能）
TARGET_CHAT_ID=-1001234567890

# 会话文件路径：可写绝对路径，或相对 PROJECT_DIR 的相对路径（如 sessions/Lona.session）
# 在 Ubuntu 上把 .session 文件放到项目里，例如 sessions/Lona.session
SESSION_PATH=sessions/Lona.session

# === 流水线配置 ===
# 监听根目录（与 src/config.py:OBSERVER_PATH 对齐，相对 PROJECT_DIR 或绝对路径）
# 旧名 DOWNLOAD_ROOT 已废弃，请使用 OBSERVER_PATH；视频放到 <OBSERVER_PATH>/<model_name>/*.mp4
OBSERVER_PATH=download

# model 内并发上传数（同一 session，建议 2~4）
UPLOAD_CONCURRENCY=3
# 上传失败重试上限（达阈值后标记 failed）
UPLOAD_MAX_RETRIES=3
# 单个视频上传超时（秒），超时则跳过该视频（默认 20 分钟）
UPLOAD_TIMEOUT=1200
