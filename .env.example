# === 进程身份（改这些必须重启） ===
# Telegram API：https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here

# 控制台监听
# API_HOST=127.0.0.1
# API_PORT=8000

# 保护写接口（设置 / Worker / 重试 / 清除）。为空则不校验。
# API_TOKEN=

# 可选 HTTP/HTTPS 代理，创建 Session 与上传共用
# TELEGRAM_PROXY=http://127.0.0.1:7890

# upload.toml 里 chat_id 省略或为 0 时的回退目标群
# TARGET_CHAT_ID=-1001234567890

# 上传策略（监听目录、封面、传完是否删文件、并发、重试）在 upload.toml，可热更新。
# Session 文件放 sessions/*.session，运行中增删会自动加载/卸载。
