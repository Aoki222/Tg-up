# === 系统配置（改 API 需要重启进程） ===
# Telegram API：https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here

# Bot Token（可选）
BOT_TOKEN=

# 会话：把已登录的 *.session 放到 sessions/ 目录即可。
# 文件名即 worker 名（Homa.session -> worker Homa）。
# 运行中新增或删掉 session 文件会自动加载/卸载，不必重启。

# 上传策略（目标群、截图、传完是否删文件、并发等）在 upload.toml，可热更新
# 若 upload.toml 里 chat_id 省略或为 0，仍可把目标群写在这里：
# TARGET_CHAT_ID=-1001234567890
